# Python bytecode and virtual environments
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
# uv.lock is committed: plugin launches and CI use the same dependency snapshot.

# Build, test, lint, and coverage output
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.log

# Local application indexes and temporary files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.tmp
*.writeback-tmp
*.enl.toolkit.lock
*.enl.writeback-recovery/
backups/

# Private EndNote libraries, exports, and attachments
*.enl
*.enlx
*.MYD
*.MYI
*.frm
*.pdf
*.Data/
/*.xml
/class/

# Local experiments and generated classification output
/_classify/
/_writeback-test/
*.BACKUP-*/

# Machine-specific agent configuration and project notes.
# `/.mcp.json` is deliberately NOT ignored: it is the plugin's server manifest
# (see .claude-plugin/plugin.json) and has to ship with the repository.
/.codex/
/.claude/
/skills/**/scripts/out/
/CLAUDE.md

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/
